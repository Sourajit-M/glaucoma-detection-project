# ─────────────────────────────────────────────────────────────────────
# Python ecosystem
# ─────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ─────────────────────────────────────────────────────────────────────
# Machine learning & data
# ─────────────────────────────────────────────────────────────────────

# Datasets — not redistributable, too large for git
datasets/
raw_data/

# Model weight files — regenerate with export_onnx.py
*.pth
*.pt
*.onnx
*.pkl
*.joblib
*.pb
*.h5
*.weights

# Outputs — keep figures for README, ignore everything else
outputs/results/
outputs/logs/
outputs/models/

# Keep figures tracked (used in README and paper)
!outputs/figures/

# Jupyter
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ─────────────────────────────────────────────────────────────────────
# Web — frontend
# ─────────────────────────────────────────────────────────────────────
node_modules/
webapp/frontend/node_modules/
webapp/frontend/dist/
webapp/frontend/build/
.next/
out/
.vite/
.turbo/

# ─────────────────────────────────────────────────────────────────────
# Web — backend models folder (onnx files copied here for serving)
# ─────────────────────────────────────────────────────────────────────
webapp/backend/models/

# ─────────────────────────────────────────────────────────────────────
# Environment files — never commit secrets
# ─────────────────────────────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
webapp/backend/.env
webapp/frontend/.env
webapp/frontend/.env.production

# Keep example templates tracked so others can configure
!.env.example
!webapp/backend/.env.example

# ─────────────────────────────────────────────────────────────────────
# IDEs and editors
# ─────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ─────────────────────────────────────────────────────────────────────
# OS-generated files
# ─────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ─────────────────────────────────────────────────────────────────────
